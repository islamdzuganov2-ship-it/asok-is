DATABASE_URL=postgresql://user:pass@localhost:5432/asok_is
REDIS_URL=redis://localhost:6379/0
# ИБ-Ф1: пароль Redis (requirepass). docker-compose подставляет его и в сам Redis, и в REDIS_URL
# бэкенда/воркера. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=change_in_prod
JWT_SECRET_KEY=change_me_in_prod_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# LLM (in-process, МОДЕЛЬ-АГНОСТИЧНО: любой *.gguf из LOCAL_LLM_MODEL_DIR)
LLM_ENABLED=true
LOCAL_LLM_MODEL_DIR=models/llm
LOCAL_LLM_MODEL_FILE=auto          # auto → автоподбор новейшего *.gguf; либо конкретное имя файла
LLM_BRAIN_DIR=models/llm_brain     # «резервный мозг»: обучение/настройки вне файла модели
LLM_N_GPU_LAYERS=0                 # 0 = CPU; -1 = offload всех слоёв на GPU (нужна CUDA-сборка)
LLM_CHAT_FORMAT=auto               # auto → шаблон чата из GGUF; иначе явный формат llama.cpp
# ИБ-04/ИБ-06: оверлей демо-стенда — Vite dev, DEMO_MODE=true, профили публикации наружу
# (tunnel/named/ngrok/direct/ddns). На продуктиве НЕ подключать. Раскомментировать на демо-стенде:
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.demo.yml
# ИБ-02: демо-стенд (демо-данные, моки, встроенные демо-учётки). По умолчанию false — продуктивный
# режим, старт с небезопасными секретами запрещён. Демо-стенд: true здесь или оверлей
# `docker compose -f docker-compose.yml -f docker-compose.demo.yml` (включает его сам).
DEMO_MODE=false
# Обход аутентификации: запрос БЕЗ токена обслуживается как ADMIN. Только для показа стенда
# без логина. НИКОГДА не включать вместе с публикацией наружу (туннель/домен) — см. ДЕФ-02.
DEMO_AUTH_BYPASS=false
# ИБ-07: /docs и /openapi.json. По умолчанию открыты (удобно локально). ПЕРЕД публикацией
# по туннелю/домену — поставить false (чек-лист: docs/REMOTE_ACCESS.md, «перед показом»).
API_DOCS_ENABLED=true
LOG_LEVEL=INFO
# ИБ-09: json — одна строка JSON на событие (для SIEM), text — для чтения глазами
LOG_FORMAT=json
# ИБ-10: анти-брутфорс входа — 5 неудач на пару логин+IP или 10 на логин за 15 минут
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_USER=10
LOGIN_FAILURE_WINDOW_S=900
LOGIN_LOCKOUT_S=900
CORS_ORIGINS=["http://localhost:3000"]
POSTGRES_USER=asok_user
POSTGRES_PASSWORD=change_in_prod
UPLOAD_DIR=/app/uploads

# Публичный доступ по статичной ссылке (опционально)
# Cloudflare named tunnel (свой домен): токен из Zero Trust → Tunnels
TUNNEL_TOKEN=
# ngrok (бесплатный статичный домен без своего домена)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Прямой хост (Caddy) + DDNS для динамического IP: токен Cloudflare Zone:DNS:Edit
CLOUDFLARE_API_TOKEN=
DDNS_DOMAINS=asokis.ai,www.asokis.ai

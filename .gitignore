__pycache__/
*.py[cod]
.pytest_cache/

node_modules/
dist/

.env

# LLM-модели — большие GGUF-бинарники, в git не хранятся (см. docs/LLM_SETUP.md)
models/llm/*.gguf

# «Резервный мозг» LLM — рантайм-данные (память/корпус/фидбэк/профиль), в git не хранятся;
# сам каталог сохраняем через .gitkeep, чтобы bind-mount имел точку монтирования.
models/llm_brain/*
!models/llm_brain/.gitkeep

# Windows-артефакт ошибочного перенаправления вывода (> nul)
nul

# Вложенный git-репозиторий-пустышка
MK/

# Рабочие деревья Claude Code (.claude/worktrees/<slug>/) — полные копии репозитория для
# параллельных агентских сессий, включая их собственные backend/.env и т.п. До этой строки
# каталог был защищён только локальным .git/info/exclude (не версионируется, не разъезжается
# по клонам/CI) — на свежем клоне или в CI ничего не мешало `git add -A` подхватить чужой .env
# из недр worktree. .gitkeep нет намеренно: содержимое эфемерно, сам каталог не должен жить в
# истории вообще.
.claude/worktrees/

# Не тащим в образ хостовые зависимости и артефакты сборки.
# КРИТИЧНО для кросс-платформенности: без этого `COPY . .` копирует хостовый node_modules
# (нативные бинарники esbuild/rollup собраны под ОС хоста) поверх зависимостей, установленных
# в образе под Linux/musl. На Linux такие бинарники не запускаются — фронтенд падает на старте.
node_modules/
dist/
.vite/

# Локальное окружение и логи в образ не нужны.
.env
.env.*
npm-debug.log*
*.log

# VCS/IDE.
.git/
.gitignore
.vscode/
